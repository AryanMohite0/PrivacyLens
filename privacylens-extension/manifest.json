{
  "manifest_version": 3,
  "name": "PRIVACYLENS - AI Privacy Inspector",
  "version": "1.0.0",
  "description": "See what websites do not tell you. Real-time website behavioral monitoring, tracker intelligence, and privacy scoring.",
  "permissions": [
    "webRequest",
    "cookies",
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PRIVACYLENS Inspector"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["disarm.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
